model Invoice {
  id String @id @default(uuid())

  invoiceNumber String @unique

  amount      Decimal @db.Decimal(10, 2)
  tax         Decimal @default(0) @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(10, 2)

  currency String @default("BDT")

  status InvoiceStatus @default(UNPAID)

  invoiceDate DateTime  @default(now())
  dueDate     DateTime?

  pdfUrl      String?
  pdfPublicId String?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)


  lawyerId String
  lawyer   Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([caseId], name: "idx_invoice_case")
  @@index([clientId], name: "idx_invoice_client")
  @@index([lawyerId], name: "idx_invoice_lawyer")
  @@index([status], name: "idx_invoice_status")
  @@map("invoices")
}
