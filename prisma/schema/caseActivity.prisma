model CaseActivity {
  id String @id @default(uuid())

  action  String
  message String?

  oldStatus CaseStatus?
  newStatus CaseStatus?

  metadata Json?

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@index([caseId], name: "idx_case_activity_case")
  @@index([createdAt], name: "idx_case_activity_createdAt")
  @@index([createdById], name: "idx_case_activity_createdBy")
  @@map("case_activities")
}
