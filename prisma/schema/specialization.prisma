model Specialization {
  id String @id @default(uuid())

  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lawyers LawyerSpecialization[]
  requests LawyerSpecializationRequest[]

  @@map("specializations")
}

model LawyerSpecialization {
  id String @id @default(uuid())

  lawyerId String
  lawyer   Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@unique([lawyerId, specializationId])
  @@index([lawyerId])
  @@index([specializationId])
  @@map("lawyer_specializations")
}

model LawyerSpecializationRequest {
  id String @id @default(uuid())

  lawyerId String
  lawyer   Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  status          SpecializationRequestStatus @default(PENDING)
  rejectionReason String?
  reviewedBy     String?
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lawyerId, specializationId, status])
  @@index([status])
  @@index([lawyerId])
  @@index([specializationId])
  @@map("lawyer_specialization_requests")
}
