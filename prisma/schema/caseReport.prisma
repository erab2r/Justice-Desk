model CaseReport {
  id String @id @default(uuid())

  title   String
  summary String?

  reportUrl      String?
  reportPublicId String?


  generatedById String?
  generatedBy   User?   @relation(fields: [generatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([caseId], name: "idx_case_report_case")
  @@index([generatedById], name: "idx_case_report_generatedBy")
  @@map("case_reports")
}
