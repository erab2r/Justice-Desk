        { "name": "05 - Update Case", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated property consultation\",\n  \"priority\": \"MEDIUM\"\n}" }, "url": "{{baseUrl}}/api/v1/case/{{caseId}}" } },
