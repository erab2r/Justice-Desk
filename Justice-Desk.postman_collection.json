        { "name": "02 - My Cases (Client)", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/case/my-cases?page=1&limit=10" } },
