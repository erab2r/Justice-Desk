        { "name": "08 - Assign Lawyer (Admin)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"lawyerId\": \"{{lawyerId}}\"\n}" }, "url": "{{baseUrl}}/api/v1/case/assign-lawyer/{{caseId}}" } },
