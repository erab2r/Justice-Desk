{
  "info": {
    "_postman_id": "4eaf7f6a-7e44-4b72-9f4d-justice-desk",
    "name": "Justice Desk API",
    "description": "Postman collection for the Justice Desk lawyer and legal case management API. Set baseUrl, credentials, and resource IDs in collection variables. Schedules use one time range with a lawyer-provided totalSlots capacity; appointments receive sequential serial numbers when payment is confirmed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "clientEmail", "value": "client@example.com" },
    { "key": "clientPassword", "value": "Client@12345" },
    { "key": "lawyerEmail", "value": "lawyer@example.com" },
    { "key": "lawyerPassword", "value": "Lawyer@12345" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "Admin@12345" },
    { "key": "otp", "value": "123456" },
    { "key": "googleIdToken", "value": "replace-with-google-id-token" },
    { "key": "scheduleId", "value": "replace-with-schedule-id" },
    { "key": "appointmentId", "value": "replace-with-appointment-id" },
    { "key": "paymentId", "value": "replace-with-payment-id" },
    { "key": "lawyerId", "value": "replace-with-lawyer-id" },
    { "key": "specializationId", "value": "replace-with-specialization-id" },
    { "key": "secondSpecializationId", "value": "replace-with-second-specialization-id" },
    { "key": "specializationRequestId", "value": "replace-with-specialization-request-id" },
    { "key": "caseId", "value": "replace-with-case-id" },
    { "key": "activityId", "value": "replace-with-activity-id" },
    { "key": "messageId", "value": "replace-with-message-id" },
    { "key": "reportId", "value": "replace-with-report-id" },
    { "key": "invoiceId", "value": "replace-with-invoice-id" },
    { "key": "noteId", "value": "replace-with-note-id" },
    { "key": "documentId", "value": "replace-with-document-id" },
    { "key": "paymentGateway", "value": "STRIPE" }
  ],
  "item": [
    {
      "name": "Health and Public",
      "item": [
        {
          "name": "GET Root",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/" }
        },
        {
          "name": "GET bKash Test Token",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/test" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Client\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\",\n  \"client\": {\n    \"contactNumber\": \"+8801712345678\",\n    \"address\": \"Dhaka, Bangladesh\",\n    \"gender\": \"OTHER\",\n    \"dateOfBirth\": \"1995-01-15\"\n  }\n}" },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Verify Client Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"otp\": \"{{otp}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/verify-email"
          }
        },
        {
          "name": "Login Client",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json?.data?.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);", "if (json?.data?.refreshToken) pm.collectionVariables.set('refreshToken', json.data.refreshToken);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login Admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json?.data?.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);", "if (json?.data?.refreshToken) pm.collectionVariables.set('refreshToken', json.data.refreshToken);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login Lawyer",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json?.data?.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);", "if (json?.data?.refreshToken) pm.collectionVariables.set('refreshToken', json.data.refreshToken);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{lawyerEmail}}\",\n  \"password\": \"{{lawyerPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/google"
          }
        },
        {
          "name": "Get Current User",
          "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/auth/me" }
        },
        {
          "name": "Refresh Token",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/v1/auth/refresh-token" }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/v1/auth/logout" }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clientEmail}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/forgot-password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"otp\": \"{{otp}}\",\n  \"newPassword\": \"NewClient@12345\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/reset-password"
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Update Profile Image",
          "request": {
            "method": "PATCH",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "body": { "mode": "formdata", "formdata": [{ "key": "profileImage", "type": "file", "src": "" }] },
            "url": "{{baseUrl}}/api/v1/user/profile-image"
          }
        }
      ]
    },
    {
      "name": "Specializations",
      "description": "Admin creates and reviews specializations. Lawyers submit requests; only approved requests become active lawyer specializations.",
      "item": [
        {
          "name": "List Specializations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/specialization/"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "const first = json?.data?.[0];", "if (first?.id) pm.collectionVariables.set('specializationId', first.id);", "const second = json?.data?.[1];", "if (second?.id) pm.collectionVariables.set('secondSpecializationId', second.id);"] } }]
        },
        {
          "name": "Admin Create Specialization",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Criminal Law\",\n  \"description\": \"Legal matters involving criminal offenses and defense.\"\n}" },
            "url": "{{baseUrl}}/api/v1/specialization/"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json?.data?.id) pm.collectionVariables.set('specializationId', json.data.id);"] } }]
        },
        {
          "name": "Admin Update Specialization",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated specialization description.\"\n}" },
            "url": "{{baseUrl}}/api/v1/specialization/{{specializationId}}"
          }
        },
        {
          "name": "Lawyer Request Specialization",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"specializationId\": \"{{specializationId}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/specialization/requests"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "if (json?.data?.id) pm.collectionVariables.set('specializationRequestId', json.data.id);"] } }]
        },
        {
          "name": "Admin List Specialization Requests",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/v1/specialization/requests"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "const pending = json?.data?.find((request) => request.status === 'PENDING');", "if (pending?.id) pm.collectionVariables.set('specializationRequestId', pending.id);"] } }]
        },
        {
          "name": "Admin Approve Specialization Request",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"requestId\": \"{{specializationRequestId}}\",\n  \"status\": \"APPROVED\"\n}" },
            "url": "{{baseUrl}}/api/v1/specialization/requests/review"
          }
        },
        {
          "name": "My Approved Specializations",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/v1/specialization/me"
          }
        },
        {
          "name": "Lawyer Remove Specialization",
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/v1/specialization/me/{{specializationId}}"
          }
        }
      ]
    },
    {
      "name": "Appointments and Payments",
      "item": [
        {
          "name": "Book Appointment - Stripe or bKash",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"scheduleId\": \"{{scheduleId}}\",\n  \"paymentGateway\": \"{{paymentGateway}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/appointment/book-appointment"
          }
        },
        {
          "name": "Pay Existing Appointment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\",\n  \"paymentGateway\": \"{{paymentGateway}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/appointment/pay-appointment"
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/appointment/cancel-appointment"
          }
        },
        {
          "name": "bKash Callback",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/appointment/book-appointment/payment/callback?paymentID=replace-with-bkash-payment-id&status=success" }
        },
        {
          "name": "Stripe Webhook - manual signature testing",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "stripe-signature", "value": "replace-with-stripe-cli-signature" }],
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"evt_test_webhook\",\n  \"object\": \"event\",\n  \"api_version\": \"2025-01-27.acacia\",\n  \"created\": 1700000000,\n  \"data\": {\n    \"object\": {\n      \"id\": \"cs_test_session\",\n      \"object\": \"checkout.session\",\n      \"metadata\": {\n        \"appointmentId\": \"{{appointmentId}}\"\n      },\n      \"payment_status\": \"paid\",\n      \"payment_intent\": \"pi_test_intent\"\n    }\n  },\n  \"livemode\": false,\n  \"pending_webhooks\": 1,\n  \"request\": {\n    \"id\": null,\n    \"idempotency_key\": null\n  },\n  \"type\": \"checkout.session.completed\"\n}" },
            "url": "{{baseUrl}}/api/v1/appointment/stripe/webhook"
          }
        },
        {
          "name": "Lawyer Update Appointment Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ONGOING\"\n}" },
            "url": "{{baseUrl}}/api/v1/appointment/update-status/{{appointmentId}}"
          }
        },
        {
          "name": "Client Join Appointment",
          "description": "Client-only route. The current time must be between the schedule startDateTime and endDateTime. Sets joiningTime and changes CONFIRMED to ONGOING; an already ONGOING appointment keeps its status.",
          "request": {
            "method": "POST",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/v1/appointment/join/{{appointmentId}}"
          }
        },
        { "name": "My Appointments", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/appointment/my-appointments?page=1&limit=10&status=CONFIRMED" } },
        { "name": "Lawyer Appointments", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/appointment/lawyer-appointments?page=1&limit=10" } },
        { "name": "All Appointments", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/appointment/all-appointments?page=1&limit=10" } },
        { "name": "Get Appointment", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/appointment/{{appointmentId}}" } }
      ]
    },
    {
      "name": "Schedules",
      "item": [
        {
          "name": "Create Schedule",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"startDateTime\": \"2030-08-25T15:00:00.000Z\",\n  \"endDateTime\": \"2030-08-25T17:00:00.000Z\",\n  \"meetingLink\": \"https://meet.example.com/justice-demo\",\n  \"totalSlots\": 10\n}" }, "url": "{{baseUrl}}/api/v1/schedule/" }
        },
        { "name": "My Schedules", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/schedule/my-schedules?page=1&limit=10" } },
        { "name": "Today's Schedules", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/schedule/today" } },
        { "name": "Available Schedules", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/schedule/available?page=1&limit=10&lawyerId={{lawyerId}}" } },
        { "name": "All Schedules", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/schedule/all-schedules?page=1&limit=10&status=PUBLISHED" } },
        { "name": "Get Schedule", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/schedule/{{scheduleId}}" } },
        { "name": "Update Schedule", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"startDateTime\": \"2030-08-25T15:00:00.000Z\",\n  \"endDateTime\": \"2030-08-25T18:00:00.000Z\",\n  \"meetingLink\": \"https://meet.example.com/justice-updated\",\n  \"totalSlots\": 12\n}" }, "url": "{{baseUrl}}/api/v1/schedule/{{scheduleId}}" } },
        { "name": "Publish Schedule", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"status\": \"PUBLISHED\"\n}" }, "url": "{{baseUrl}}/api/v1/schedule/{{scheduleId}}/status" } },
        { "name": "Delete Schedule", "request": { "method": "DELETE", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/schedule/{{scheduleId}}" } }
      ]
    },
    {
      "name": "Payment Queries",
      "item": [
        { "name": "My Payments", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/payment/my-payments?page=1&limit=10" } },
        { "name": "All Payments", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/payment/all-payments?page=1&limit=10&paymentGateway=STRIPE&status=PAID" } },
        { "name": "Get Payment", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/payment/{{paymentId}}" } }
      ]
    },
    {
      "name": "Lawyer Module",
      "description": "Lawyer applications require one or more specialization IDs. Selected specializations remain pending until an admin approves their requests.",
      "item": [
        { "name": "Apply as Lawyer - multipart", "request": { "method": "POST", "header": [], "body": { "mode": "formdata", "formdata": [{ "key": "user", "value": "{\"name\":\"Test Lawyer\",\"email\":\"{{lawyerEmail}}\"}", "type": "text" }, { "key": "lawyer", "value": "{\"licenseNumber\":\"BD-LAW-1001\",\"qualifications\":\"LLB\",\"experienceYears\":5,\"bio\":\"Civil litigation lawyer\",\"consultationFee\":1500,\"contactNumber\":\"+8801812345678\",\"specializationIds\":[\"{{specializationId}}\",\"{{secondSpecializationId}}\"]}", "type": "text" }, { "key": "resume", "type": "file", "src": "" }, { "key": "additionalFiles", "type": "file", "src": "" }] }, "url": "{{baseUrl}}/api/v1/lawyer/apply-lw" } },
        { "name": "Verify Lawyer Email", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{lawyerEmail}}\",\n  \"otp\": \"{{otp}}\"\n}" }, "url": "{{baseUrl}}/api/v1/lawyer/verify-email" } },
        { "name": "Approve Lawyer", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "body": { "mode": "raw", "raw": "{\n  \"lawyerId\": \"{{lawyerId}}\",\n  \"verificationStatus\": \"APPROVED\"\n}" }, "url": "{{baseUrl}}/api/v1/lawyer/approve-lw" } },
        { "name": "Admin All Lawyers", "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/lawyer/all-lawyers?page=1&limit=10" } },
